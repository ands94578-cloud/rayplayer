{
  "show": "Ray Player",
  "notes": "Model ids move fast -- replace each one with an id your key can actually call. kind is the wire protocol, not the company: anything OpenAI-compatible (xAI, DeepSeek, Groq, OpenRouter, vLLM, Ollama) uses openai-compatible with its own base_url.",
  "language": "zh-Hant",
  "policy": "moderator",
  "temperature": 0.8,
  "max_words": 90,
  "max_tokens": 600,
  "host": {
    "name": "Ray",
    "provider": {
      "kind": "anthropic",
      "model": "claude-opus-5",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "max_words": 70
  },
  "speakers": [
    {
      "name": "Claude",
      "provider": {
        "kind": "anthropic",
        "model": "claude-opus-5",
        "api_key_env": "ANTHROPIC_API_KEY"
      }
    },
    {
      "name": "GPT",
      "provider": {
        "kind": "openai",
        "model": "gpt-5",
        "base_url": "https://api.openai.com/v1",
        "api_key_env": "OPENAI_API_KEY"
      }
    },
    {
      "name": "Gemini",
      "provider": {
        "kind": "gemini",
        "model": "gemini-2.5-pro",
        "api_key_env": "GEMINI_API_KEY"
      }
    },
    {
      "name": "Grok",
      "provider": {
        "kind": "openai-compatible",
        "model": "grok-4",
        "base_url": "https://api.x.ai/v1",
        "api_key_env": "XAI_API_KEY"
      }
    }
  ]
}
